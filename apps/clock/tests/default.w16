# Clock with no CLOCK.INI: 3.11 starts it digital with seconds and the date, 9:30:03 (Clock starts on
# the second after ARCH311_CLOCK) - as arch311-ref/scn/clock-def.scn, frame 01.
# KNOWN DIFFERENCE: the time and date are TrueType Arial in 3.11; libw16 has no TrueType rasterizer
# yet and falls back to the MS Sans Serif raster font, so the two text lines are left out below. The
# window, caption, menu bar and face around them must match.
# regress: ARCH311_CLOCK="2026-10-08 09:30:02" sh apps/clock/tests/clock.sh "$TEST" "$OUT"
# compare: clock-def/01.png 01-default.png ignore 320 240 333 261 ignore 4 100 204 164
sleep 150
shot shots/01-default.png
quit
