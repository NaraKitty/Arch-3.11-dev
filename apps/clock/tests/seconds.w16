# Analog face with the second hand (R2_NOT) at 9:30:03 - Clock starts on the next second after
# ARCH311_CLOCK, so the shot has to come within that second
# reference: clock-def.scn with -PrivateIni 'CLOCK.INI:Clock/Options=1,0,0,0,0,0' (its frame shows :03)
# regress: ARCH311_CLOCK="2026-10-08 09:30:02" sh apps/clock/tests/clock.sh "$TEST" "$OUT" "Options=1,0,0,0,0,0"
# compare: clock-ans/01.png 01.png ignore 320 240 333 261
sleep 150
shot shots/01.png
quit
