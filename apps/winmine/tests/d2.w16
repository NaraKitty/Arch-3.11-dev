# Minesweeper Best Times with WINMINE.INI seeded as d2.ini (the rig writes the same lines with DOS
# echo): Esc closes it; again, Tab + Space = Reset Scores, Esc; Tab, Enter; Exit (the INI keeps its
# lines, rewritten in place, and gets the others appended). Same keys as d2.scn, run on real 3.11 as
# arch311-ref/scn/winmine-d2.scn (the rig records no new frame for the last Tab, Enter).
# regress: WINMINE_INI=apps/winmine/tests/d2.ini sh apps/winmine/tests/run.sh "$TEST" "$OUT"
# compare: winmine-d2/02.png 01.png ignore 320 240 332 260
# compare: winmine-d2/03.png 02.png ignore 320 240 332 260
# compare: winmine-d2/04.png 03.png ignore 320 240 332 260
# compare: winmine-d2/05.png 04.png ignore 320 240 332 260
# compare: winmine-d2/06.png 05.png ignore 320 240 332 260
# compare: winmine-d2/06.png 06.png ignore 320 240 332 260
# ini: WINMINE.INI Minesweeper Time1=999
# ini: WINMINE.INI Minesweeper Name1=Anonymous
# ini: WINMINE.INI Minesweeper Time2=999
# ini: WINMINE.INI Minesweeper Name2=Anonymous
# ini: WINMINE.INI Minesweeper Time3=999
# ini: WINMINE.INI Minesweeper Name3=Anonymous
# ini: WINMINE.INI Minesweeper Difficulty=0
# ini: WINMINE.INI Minesweeper Ypos=80
sleep 400
key alt
key g
key t
sleep 400
shot shots/01.png
key esc
sleep 400
shot shots/02.png
key alt
key g
key t
sleep 400
shot shots/03.png
key tab
key space
sleep 400
shot shots/04.png
key esc
sleep 400
shot shots/05.png
key tab
key enter
sleep 400
shot shots/06.png
key alt
key g
key x
quit
