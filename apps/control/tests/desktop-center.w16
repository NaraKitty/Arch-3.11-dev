# Desktop: pattern Critters, wallpaper winlogo.bmp centred (Left from the checked Tile), OK: the desktop
# shows the pattern around the centred wallpaper. Same keys as arch311-ref/scn/desktop-center.scn.
# Run: ARCH311_REF=<rig> ARCH311_REF_INI=1 tools/run-cp-test.sh apps/control/tests/desktop-center.w16 OUT Desktop
# The rig caught no frame with Center checked (03-center).
# regress: ARCH311_REF_INI=1 sh tools/run-cp-test.sh "$TEST" "$OUT" Desktop
# compare: desk-center/02.png 01-desktop.png active ignore 320 240 332 260 ignore 338 334 350 354
# compare: desk-center/03.png 02-tile.png active ignore 320 240 332 260 ignore 338 334 350 354
# compare: desk-center/04.png 04-ok.png 0 240 640 480 ignore 320 240 332 260
# compare: desk-center/04.png 04-ok.png 430 0 640 240
# ini: WIN.INI windows CoolSwitch=1
# ini: WIN.INI Desktop Pattern=0 80 114 32 0 5 39 2
# ini: WIN.INI Desktop Wallpaper=winlogo.bmp
# ini: WIN.INI Desktop IconSpacing=75
# ini: WIN.INI Desktop TileWallPaper=0
# ini: SYSTEM.INI boot SCRNSAVE.EXE=(None)
sleep 600
shot shots/01-desktop.png
key down
key down
key down
key tab
key tab
key tab
key tab
key tab
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key tab
sleep 200
shot shots/02-tile.png
key left
sleep 200
shot shots/03-center.png
key enter
sleep 800
shot shots/04-ok.png
quit
