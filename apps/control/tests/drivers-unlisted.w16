# Drivers > Add... > Unlisted or Updated Driver: ARCH311_REF_INI=1 tools/run-cp-test.sh apps/control/tests/drivers-unlisted.w16 OUT Drivers
# Same keys as arch311-ref/scn/drivers-unlisted.scn: the Install Driver path dialog (1006) with "A:\";
# OK finds no OEMSETUP.INF on the empty A: and shows it again; Cancel ends Add too
# regress: ARCH311_REF_INI=1 sh tools/run-cp-test.sh "$TEST" "$OUT" Drivers
# compare: drivers-unlisted/04.png 01-install.png active ignore 320 239 333 261
# compare: drivers-unlisted/04.png 02-again.png active ignore 320 239 333 261
# compare: drivers-unlisted/05.png 03-close.png active ignore 320 239 333 261
# ini: SYSTEM.INI drivers timer=timer.drv
sleep 900
key tab
key tab
key space
sleep 500
key enter
sleep 500
shotcaret shots/01-install.png
key enter
sleep 500
shotcaret shots/02-again.png
key esc
sleep 500
shot shots/03-close.png
key esc
sleep 300
shot shots/04-closed.png
quit
