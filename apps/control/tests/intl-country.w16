# International: Germany picked in the Country list (the samples change), then OK - WIN.INI [intl]
# is written. Same keys as arch311-ref/scn/intl-country.scn after opening. Run as intl.w16
# (ARCH311_PRISTINE_INI=1, ARCH311_CLOCK="2026-10-08 09:30:24", applet International): the
# reference's time sample read :24 when the dialog opened and :28 after the country change; the
# pauses put the port's change half a second into :28.
# regress: ARCH311_PRISTINE_INI=1 ARCH311_CLOCK="2026-10-08 09:30:24" sh tools/run-cp-test.sh "$TEST" "$OUT" International
# compare: intl-country/02.png 01-open.png active ignore 320 240 332 260
# compare: intl-country/03.png 02-germany.png active ignore 320 240 332 260
# ini: WIN.INI intl sCountry=Germany
# ini: WIN.INI intl iCountry=49
# ini: WIN.INI intl iDate=1
# ini: WIN.INI intl iTime=1
# ini: WIN.INI intl iTLZero=1
# ini: WIN.INI intl iCurrency=3
# ini: WIN.INI intl iCurrDigits=2
# ini: WIN.INI intl iNegCurr=8
# ini: WIN.INI intl iLzero=1
# ini: WIN.INI intl iDigits=2
# ini: WIN.INI intl iMeasure=0
# ini: WIN.INI intl s1159=
# ini: WIN.INI intl s2359=
# ini: WIN.INI intl sCurrency=DM
# ini: WIN.INI intl sThousand=.
# ini: WIN.INI intl sDecimal=,
# ini: WIN.INI intl sDate=.
# ini: WIN.INI intl sTime=:
# ini: WIN.INI intl sList=;
# ini: WIN.INI intl sShortDate=dd.MM.yyyy
# ini: WIN.INI intl sLongDate=dddd, d. MMMM yyyy
# ini: WIN.INI intl sLanguage=enu
sleep 900
shot shots/01-open.png
sleep 3600
type g
sleep 500
shot shots/02-germany.png
key enter
sleep 400
quit
