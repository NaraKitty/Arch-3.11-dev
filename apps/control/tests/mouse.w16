# Mouse applet (MAIN.CPL dialog 6): tools/run-cp-test.sh apps/control/tests/mouse.w16 OUT Mouse
# Same keys as arch311-ref/scn/mouse.scn
# regress: sh tools/run-cp-test.sh "$TEST" "$OUT" Mouse
# compare: mouse/02.png 01-mouse.png active
sleep 600
shotcaret shots/01-mouse.png
key right
key right
key tab
key left
key left
key left
key tab
sleep 200
shot shots/02-changed.png
key space
sleep 200
shot shots/03-swapped.png
key enter
sleep 300
shot shots/04-closed.png
quit
