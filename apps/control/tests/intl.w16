# International (MAIN.CPL dialog 3), just opened, then Cancel. Same keys as
# arch311-ref/scn/intl-open.scn after opening. Run with the reference install's INI files (Setup's
# SYSTEM.INI [boot.description] language.dll picks the language) and its clock when it opened:
#   ARCH311_REF=<rig> ARCH311_PRISTINE_INI=1 ARCH311_CLOCK="2026-10-08 09:30:24" \
#   tools/run-cp-test.sh apps/control/tests/intl.w16 OUT International
# regress: ARCH311_PRISTINE_INI=1 ARCH311_CLOCK="2026-10-08 09:30:24" sh tools/run-cp-test.sh "$TEST" "$OUT" International
# compare: intl-open/02.png 01-open.png active ignore 320 240 332 260
sleep 900
shot shots/01-open.png
key esc
sleep 300
quit
