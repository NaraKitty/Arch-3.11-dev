# Drivers > Add... (dialog 1003): ARCH311_REF_INI=1 tools/run-cp-test.sh apps/control/tests/drivers-add.w16 OUT Drivers
# Same keys as arch311-ref/scn/drivers-add.scn: SETUP.INF's [Installable.drivers] under "Unlisted or
# Updated Driver", scrolled, Cancel (the Drivers dialog's Cancel becomes Close)
# regress: ARCH311_REF_INI=1 sh tools/run-cp-test.sh "$TEST" "$OUT" Drivers
# compare: drivers-add/02.png 01-open.png active ignore 320 239 333 261
# compare: drivers-add/03.png 02-add.png active ignore 320 239 333 261
# compare: drivers-add/04.png 03-down.png active ignore 320 239 333 261
# compare: drivers-add/05.png 04-end.png active ignore 320 239 333 261
# compare: drivers-add/06.png 05-home.png active ignore 320 239 333 261
# compare: drivers-add/07.png 06-close.png active ignore 320 239 333 261
# ini: SYSTEM.INI drivers timer=timer.drv
# ini: SYSTEM.INI drivers midimapper=midimap.drv
sleep 900
shot shots/01-open.png
key tab
key tab
key space
sleep 500
shot shots/02-add.png
key down
sleep 300
shot shots/03-down.png
key end
sleep 300
shot shots/04-end.png
key home
sleep 300
shot shots/05-home.png
key esc
sleep 400
shot shots/06-close.png
key esc
sleep 300
shot shots/07-closed.png
quit
