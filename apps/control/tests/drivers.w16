# Drivers (DRIVERS.CPL dialog 1001): tools/run-cp-test.sh apps/control/tests/drivers.w16 OUT Drivers
# Same keys as arch311-ref/scn/drivers-open.scn (after opening): the installed list walked (Setup...
# enabled only for [MCI] Sound), Home, close. Opening caches the descriptions in CONTROL.INI.
# regress: ARCH311_REF_INI=1 sh tools/run-cp-test.sh "$TEST" "$OUT" Drivers
# compare: drivers-open/02.png 01-open.png active ignore 320 239 333 261
# compare: drivers-open/03.png 02-timer.png active ignore 320 239 333 261
# compare: drivers-open/04.png 03-sequencer.png active ignore 320 239 333 261
# compare: drivers-open/05.png 04-sound.png active ignore 320 239 333 261
# compare: drivers-open/06.png 05-home.png active ignore 320 239 333 261
# ini: CONTROL.INI drivers.desc mciwave.drv=[MCI] Sound
# ini: CONTROL.INI drivers.desc mciseq.drv=[MCI] MIDI Sequencer
# ini: CONTROL.INI drivers.desc timer.drv=Timer
# ini: CONTROL.INI drivers.desc midimap.drv=MIDI Mapper
# ini: CONTROL.INI drivers.desc mcicda.drv=
sleep 900
shot shots/01-open.png
key down
sleep 300
shot shots/02-timer.png
key down
sleep 300
shot shots/03-sequencer.png
key down
sleep 300
shot shots/04-sound.png
key home
sleep 300
shot shots/05-home.png
key esc
sleep 300
shot shots/06-closed.png
quit
