# Notepad File > Open (COMMDLG): a file that does not exist ("nofile.txt\nCannot find this file...") and
# a directory that does not exist ("nodir\a.txt\nPath does not exist..."). Reference: arch311-ref
# scn/cdlg-missing.scn (frame 01 is Notepad before the scenario starts). The recorder kept the edit as
# it was part way through the typing ("nofile.", "nodir\"), so the script shoots there too. The message
# box frames are compared on the whole screen (the dialog behind them shows inactive).
# regress: sh tools/run-fixture-test.sh notepad "$TEST" "$OUT"
# compare: cdlg-missing/02.png 01-open.png active ignore 320 240 332 260
# compare: cdlg-missing/03.png 02-typed.png active ignore 320 240 332 260
# compare: cdlg-missing/04.png 03-box.png ignore 320 240 332 260
# compare: cdlg-missing/07.png 06-box.png ignore 320 240 332 260
# compare: cdlg-missing/05.png 04-back.png active ignore 320 240 332 260
# compare: cdlg-missing/06.png 05-typed.png active ignore 320 240 332 260
# compare: cdlg-missing/08.png 07-back.png active ignore 320 240 332 260
# compare: cdlg-missing/09.png 08-closed.png active ignore 316 228 333 261
sleep 400
key alt+f
key o
sleep 400
shotcaret shots/01-open.png
type nofile.
sleep 400
shotcaret shots/02-typed.png
type txt
key enter
sleep 400
shot shots/03-box.png
key enter
sleep 400
shotcaret shots/04-back.png
type nodir\
sleep 400
shotcaret shots/05-typed.png
type a.txt
key enter
sleep 400
shot shots/06-box.png
key enter
sleep 400
shotcaret shots/07-back.png
key esc
sleep 400
shotcaret shots/08-closed.png
quit
