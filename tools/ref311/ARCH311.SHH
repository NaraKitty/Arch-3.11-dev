; Unattended Setup for the arch311 reference install (SETUP /H:ARCH311.SHH)
[sysinfo]
showsysinfo=no

[configuration]
machine = ibm_compatible
display = vga
mouse = ps2mouse
network = nonet
keyboard = t4s0enha
language = enu
kblayout = nodll

[windir]
c:\windows

[userinfo]
"arch311 reference"
""

[endinstall]
configfiles = save
endopt      = exit
